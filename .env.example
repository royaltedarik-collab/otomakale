# AI Servisleri (Sadece Groq - Ana Motoru)
GROQ_API_KEY=gsk_your_groq_key_here

# Sosyal Medya - Twitter
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Sosyal Medya - Facebook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token

# Sosyal Medya - LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# Sosyal Medya - Pinterest (Opsiyonel)
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token

# Google Indexing API
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Site Ayarları
SITE_URL=http://localhost:3000
SITE_NAME=AI Araçları Hub
SITE_DESCRIPTION=En güncel AI araçları ve verimlilik ipuçları
SITE_AUTHOR=AI Blog Bot

# Veritabanı
DATABASE_PATH=./database/blog.db

# Otomasyon Ayarları
AUTO_PUBLISH=true
POSTS_PER_DAY=3
PUBLISH_HOURS=09,14,19
TIMEZONE=Europe/Istanbul

# İçerik Ayarları
MIN_WORD_COUNT=1500
MAX_WORD_COUNT=2500
INCLUDE_FAQ=true
INCLUDE_IMAGES=true

# Görsel Ayarları
IMAGE_API=pollinations
IMAGE_WIDTH=1200
IMAGE_HEIGHT=630

# SEO Ayarları
AUTO_INDEX=true
PING_GOOGLE=true
PING_BING=true

# Geliştirme
NODE_ENV=development
